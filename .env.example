# ==============================================================================
# CONFIGURACIÓN DE ENTORNO PARA SYNCTHING DOCKER
# Copia este archivo como '.env' y edita los valores según tus necesidades.
# ==============================================================================

# Identificadores de usuario y grupo en el host (ejecuta 'id' en tu terminal).
# Esto asegura que el contenedor tenga los permisos correctos sobre los archivos compartidos.
PUID=1000
PGID=1000

# Zona horaria para el contenedor
TZ=America/Bogota

# Nombre del host de Syncthing (identificador visible para otros dispositivos)
SYNCTHING_HOSTNAME=windows-10-desktop

# Ruta absoluta en la máquina host donde se almacenarán los archivos sincronizados.
SYNCTHING_DATA_DIR=/home/tu_usuario/carpeta_sincronizacion
